{
  "openapi": "3.1.1",
  "info": {
    "title": "TinyLap Planner API",
    "version": "1.0.0",
    "license": { "name": "AGPL-3.0-or-later", "identifier": "AGPL-3.0-or-later" },
    "description": "Shared Circuit 30 layouts. A layout is stored as an immutable snapshot under a key computed from its content, so the same layout always has the same link and a changed layout gets a new one. Every snapshot of one physical build is also listed under its shape key, so someone who only has the layout can find it without a link. Each URL serves HTML to browsers and JSON to everything else."
  },
  "externalDocs": {
    "description": "Snapshots, tracks and shapes: how the identifiers relate",
    "url": "https://github.com/tinylaphq/tinylap/blob/main/docs/identity.md"
  },
  "paths": {
    "/layouts": {
      "post": {
        "summary": "Store a snapshot",
        "description": "Accepts a layout as JSON, or a page the planner exported. A single closed loop must carry a track block whose shape matches its geometry (run assignTrack first); any other layout must carry none. The server never assigns track ids.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Layout" } },
            "text/html": { "schema": { "type": "string", "description": "A page exported by the planner." } }
          }
        },
        "responses": {
          "200": { "description": "The snapshot was already stored.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Snapshot" } } } },
          "201": {
            "description": "The snapshot was stored.",
            "headers": { "Location": { "schema": { "type": "string" }, "description": "/layouts/<key>" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Snapshot" } } }
          },
          "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/layouts/{key}": {
      "get": {
        "summary": "A snapshot, as JSON or as a page",
        "description": "Browsers that prefer text/html get the page with the drawing and the bill of materials; every other client gets the JSON. A public snapshot's JSON never changes and may be cached forever. A private library snapshot is served only to a member of its club (or its owner, for a personal track), with the session cookie: private, no-store, and without Access-Control-Allow-Origin; to anyone else it is the same 404 as an unknown key. Every answer varies on Cookie.",
        "parameters": [{ "$ref": "#/components/parameters/key" }],
        "responses": {
          "200": {
            "description": "The snapshot.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Layout" } },
              "text/html": { "schema": { "type": "string" } }
            }
          },
          "304": { "description": "Not modified." },
          "404": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/layouts/{key}.json": {
      "get": {
        "summary": "A snapshot as JSON, whatever Accept says",
        "parameters": [{ "$ref": "#/components/parameters/key" }],
        "responses": {
          "200": { "description": "The snapshot.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Layout" } } } },
          "304": { "description": "Not modified." },
          "404": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/layouts/{key}.html": {
      "get": {
        "summary": "A snapshot as a page, whatever Accept says",
        "parameters": [{ "$ref": "#/components/parameters/key" }],
        "responses": {
          "200": { "description": "The page.", "content": { "text/html": { "schema": { "type": "string" } } } },
          "304": { "description": "Not modified." },
          "404": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/shapes/{key}": {
      "get": {
        "summary": "Every snapshot of one build",
        "description": "Compute the key locally with shapeKey(shapeOf(layout)). Snapshots with the same track id are the same track; different track ids are separate tracks built the same way.",
        "parameters": [{ "$ref": "#/components/parameters/key" }],
        "responses": {
          "200": {
            "description": "Up to 100 snapshots, newest first.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ShapeListing" } },
              "text/html": { "schema": { "type": "string" } }
            }
          },
          "404": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This description",
        "responses": { "200": { "description": "OpenAPI 3.1.", "content": { "application/vnd.oai.openapi+json": { "schema": { "type": "object" } } } } }
      }
    },
    "/schemas/layout.json": {
      "get": {
        "summary": "The layout format as JSON Schema 2020-12",
        "responses": { "200": { "description": "The schema.", "content": { "application/schema+json": { "schema": { "type": "object" } } } } }
      }
    },
    "/.well-known/api-catalog": {
      "get": {
        "summary": "The API catalog (RFC 9727)",
        "responses": {
          "200": {
            "description": "A linkset naming this description and its docs.",
            "content": { "application/linkset+json": { "schema": { "type": "object", "required": ["linkset"] } } }
          }
        }
      }
    },
    "/problems/{name}": {
      "get": {
        "summary": "A problem type",
        "description": "Redirects to the problem type's description on /api.",
        "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "302": { "description": "To /api#problem-<name>." },
          "404": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api": {
      "get": {
        "summary": "This description as a page",
        "responses": { "200": { "description": "The docs.", "content": { "text/html": { "schema": { "type": "string" } } } } }
      }
    },
    "/auth/login": {
      "get": {
        "summary": "Sign in to TinyLap",
        "description": "A browser navigation, not an API call: the planner is a backend-for-frontend, so the tokens stay on the server and the browser only gets the session cookie. Like every /auth route, it sends no Access-Control-Allow-Origin and varies on Cookie.",
        "security": [{ "session": [] }],
        "parameters": [{ "name": "returnTo", "in": "query", "description": "Where to come back to: a path on this origin. Anything else is replaced by /.", "schema": { "type": "string" } }],
        "responses": {
          "302": { "description": "To TinyLap Accounts, with the pending sign-in in a short-lived, sealed cookie." },
          "404": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/LoginProblem" }
        }
      }
    },
    "/auth/callback": {
      "get": {
        "summary": "Where TinyLap Accounts sends the browser back",
        "description": "Exchanges the code for tokens, stores them, sets the session cookie.",
        "security": [{ "session": [] }],
        "responses": {
          "302": { "description": "Back to returnTo, with the session cookie." },
          "400": { "$ref": "#/components/responses/LoginProblem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/LoginProblem" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Sign out",
        "description": "Forgets the session, revokes its refresh token, and signs out at TinyLap Accounts too. Only from the planner's own pages: Sec-Fetch-Site: same-origin, or a same-origin Origin.",
        "security": [{ "session": [] }],
        "responses": {
          "302": { "description": "Through TinyLap Accounts' end-session endpoint back to /; the session cookie is cleared." },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Who is signed in",
        "security": [{ "session": [] }],
        "responses": {
          "200": { "description": "The sign-in state. Never cached.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginState" } } } },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/library": {
      "get": {
        "summary": "Your personal space and clubs, with their tracks",
        "description": "Your personal space and every club in your token you may read, with its tracks, most recently updated first. Like every /library route, it needs the session cookie, sends no Access-Control-Allow-Origin, varies on Cookie and is never cached. Writes must come from the planner's own pages (Sec-Fetch-Site: same-origin, or a same-origin Origin), else 403.",
        "security": [{ "session": [] }],
        "responses": {
          "200": { "description": "The library.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Library" } } } },
          "401": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/library/export": {
      "get": {
        "summary": "Every track and version in your personal space and clubs",
        "security": [{ "session": [] }],
        "responses": {
          "200": { "description": "A download (Content-Disposition: attachment).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LibraryExport" } } } },
          "401": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/library/tracks": {
      "post": {
        "summary": "Save a new track",
        "description": "Stores the layout as a private snapshot of the club or personal space, open or closed, and starts the track's history with it. Nothing is shared. At most 200 tracks in each, 64 KiB per snapshot (canonical JSON) and 60 saves per user an hour; beyond that, 422 quota-exceeded.",
        "security": [{ "session": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object", "required": ["workspaceId", "name", "layout"],
            "properties": { "workspaceId": { "type": "string" }, "name": { "type": "string", "minLength": 1, "maxLength": 100 }, "layout": { "$ref": "#/components/schemas/Layout" } }
          } } }
        },
        "responses": {
          "201": { "description": "The track.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TrackResult" } } } },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/library/tracks/{id}": {
      "patch": {
        "summary": "Rename a track",
        "security": [{ "session": [] }],
        "parameters": [{ "$ref": "#/components/parameters/trackId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 100 } } } } }
        },
        "responses": {
          "200": { "description": "The renamed track.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TrackResult" } } } },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      },
      "delete": {
        "summary": "Delete a track and its history",
        "description": "Owner and admins only; a member gets 403.",
        "security": [{ "session": [] }],
        "parameters": [{ "$ref": "#/components/parameters/trackId" }],
        "responses": {
          "204": { "description": "Deleted." },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/library/tracks/{id}/versions": {
      "get": {
        "summary": "A track's history",
        "description": "Newest first. A track keeps its 50 newest versions; older ones drop off.",
        "security": [{ "session": [] }],
        "parameters": [{ "$ref": "#/components/parameters/trackId" }],
        "responses": {
          "200": { "description": "The versions.", "content": { "application/json": { "schema": {
            "type": "object", "required": ["versions", "kept"],
            "properties": { "versions": { "type": "array", "items": { "$ref": "#/components/schemas/Version" } }, "kept": { "type": "integer", "description": "How many versions a track keeps." } }
          } } } },
          "401": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      },
      "post": {
        "summary": "Save a new version",
        "description": "The layout becomes the track's current version. Saving a snapshot the history already has moves it to the top.",
        "security": [{ "session": [] }],
        "parameters": [{ "$ref": "#/components/parameters/trackId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["layout"], "properties": { "layout": { "$ref": "#/components/schemas/Layout" } } } } }
        },
        "responses": {
          "201": { "description": "The version, and the track as it is now.", "content": { "application/json": { "schema": {
            "type": "object", "required": ["track", "version"],
            "properties": { "track": { "$ref": "#/components/schemas/Track" }, "version": { "$ref": "#/components/schemas/Version" } }
          } } } },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/library/tracks/{id}/versions/{key}": {
      "delete": {
        "summary": "Delete one version",
        "description": "Owner and admins only. If it was the current version, the newest one left becomes current; deleting the last version deletes the track.",
        "security": [{ "session": [] }],
        "parameters": [{ "$ref": "#/components/parameters/trackId" }, { "$ref": "#/components/parameters/key" }],
        "responses": {
          "204": { "description": "Deleted." },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/library/tracks/{id}/copy": {
      "post": {
        "summary": "Copy a track to your personal space or another of your clubs",
        "description": "The copy starts with the current version only. A club you are not in is a 404.",
        "security": [{ "session": [] }],
        "parameters": [{ "$ref": "#/components/parameters/trackId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["workspaceId"], "properties": { "workspaceId": { "type": "string" } } } } }
        },
        "responses": {
          "201": { "description": "The copy.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TrackResult" } } } },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/library/tracks/{id}/share": {
      "post": {
        "summary": "Share the current version",
        "description": "Stores the current version as a public snapshot, exactly as POST /layouts would (the same track-consistency rule and size limit), so its link and shape listing work for anyone. This cannot be undone. The private snapshot stays.",
        "security": [{ "session": [] }],
        "parameters": [{ "$ref": "#/components/parameters/trackId" }],
        "responses": {
          "200": { "description": "It was already public.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Snapshot" } } } },
          "201": {
            "description": "Shared.",
            "headers": { "Location": { "schema": { "type": "string" }, "description": "/layouts/<key>" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Snapshot" } } }
          },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "key": {
        "name": "key",
        "in": "path",
        "required": true,
        "description": "22 base64url characters: the first 16 bytes of a SHA-256.",
        "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" }
      },
      "trackId": { "name": "id", "in": "path", "required": true, "description": "A library track's id.", "schema": { "type": "string" } }
    },
    "schemas": {
      "Layout": { "$ref": "/schemas/layout.json" },
      "Snapshot": {
        "type": "object",
        "required": ["key", "url", "shapeKey"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" },
          "url": { "type": "string", "format": "uri" },
          "shapeKey": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{22}$", "description": "null for a layout without a track." }
        }
      },
      "ShapeListing": {
        "type": "object",
        "required": ["shapeKey", "shape", "layouts"],
        "properties": {
          "shapeKey": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" },
          "shape": { "type": "string", "pattern": "^c30:" },
          "layouts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "trackId", "createdAt"],
              "properties": {
                "key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" },
                "trackId": { "type": "string" },
                "createdAt": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      },
      "LoginState": {
        "type": "object",
        "required": ["loggedIn", "available"],
        "properties": {
          "loggedIn": { "type": "boolean" },
          "available": { "type": "boolean", "description": "false when this server has sign-in turned off." },
          "user": {
            "type": "object",
            "required": ["id", "name"],
            "properties": { "id": { "type": "string" }, "name": { "type": ["string", "null"], "description": "The display name, from TinyLap Accounts." } }
          },
          "workspaces": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "role"],
              "properties": {
                "id": { "type": "string" },
                "role": { "enum": ["owner", "admin", "member"] },
                "name": { "type": "string" }
              }
            }
          },
          "accountUrl": { "type": "string", "format": "uri", "description": "The account page at TinyLap Accounts." }
        },
        "if": { "properties": { "loggedIn": { "const": true } } },
        "then": { "required": ["user", "workspaces", "accountUrl"] }
      },
      "Saver": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "description": "The user id." },
          "name": { "type": "string", "description": "The display name at save time, or \"former member\" once the user is deleted." }
        }
      },
      "Track": {
        "type": "object",
        "required": ["id", "workspaceId", "name", "currentKey", "createdAt", "updatedAt", "updatedBy"],
        "properties": {
          "id": { "type": "string" },
          "workspaceId": { "type": "string" },
          "name": { "type": "string" },
          "currentKey": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$", "description": "The current version: a private snapshot of its club or personal space, at /layouts/<key> for its members." },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "updatedBy": { "$ref": "#/components/schemas/Saver" }
        }
      },
      "TrackResult": { "type": "object", "required": ["track"], "properties": { "track": { "$ref": "#/components/schemas/Track" } } },
      "Version": {
        "type": "object",
        "required": ["key", "savedAt", "savedBy"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" },
          "savedAt": { "type": "string", "format": "date-time" },
          "savedBy": { "$ref": "#/components/schemas/Saver" }
        }
      },
      "LibraryWorkspace": {
        "type": "object",
        "required": ["id", "name", "role"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": ["string", "null"] },
          "role": { "enum": ["owner", "admin", "member"] }
        }
      },
      "Library": {
        "type": "object",
        "required": ["workspaces"],
        "properties": {
          "workspaces": {
            "type": "array",
            "items": {
              "allOf": [{ "$ref": "#/components/schemas/LibraryWorkspace" }],
              "required": ["tracks"],
              "properties": { "tracks": { "type": "array", "items": { "$ref": "#/components/schemas/Track" } } }
            }
          }
        }
      },
      "LibraryExport": {
        "type": "object",
        "required": ["exportedAt", "workspaces"],
        "properties": {
          "exportedAt": { "type": "string", "format": "date-time" },
          "workspaces": {
            "type": "array",
            "items": {
              "allOf": [{ "$ref": "#/components/schemas/LibraryWorkspace" }],
              "required": ["tracks"],
              "properties": {
                "tracks": {
                  "type": "array",
                  "items": {
                    "allOf": [{ "$ref": "#/components/schemas/Track" }],
                    "required": ["versions"],
                    "properties": {
                      "versions": {
                        "type": "array",
                        "items": {
                          "allOf": [{ "$ref": "#/components/schemas/Version" }],
                          "required": ["layout"],
                          "properties": { "layout": { "$ref": "#/components/schemas/Layout" } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 Problem Details.",
        "required": ["type", "title", "status"],
        "properties": {
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" }
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "An error as RFC 9457 Problem Details; its type names one of the problem types below.",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "LoginProblem": {
        "description": "A page saying what happened, with a link to sign in again, for a browser (Accept prefers text/html); Problem Details for anything else.",
        "content": {
          "text/html": { "schema": { "type": "string" } },

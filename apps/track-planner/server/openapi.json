      "session": { "type": "apiKey", "in": "cookie", "name": "__Host-tinylap-session", "description": "The planner's session cookie, set by /auth/callback. HttpOnly; a browser sends it, scripts can't read it." }
    }
  },
  "x-tinylap-problems": {

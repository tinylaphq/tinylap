{
  "name": "@tinylap/design",
  "version": "0.3.0",
  "description": "The TinyLap design layer on top of palace-ui.",
  "license": "MPL-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinylaphq/tinylap.git",
    "directory": "packages/design"
  },
  "style": "design.css",
  "exports": {
    "./design.css": "./design.css",
    "./elements/*": "./elements/*",
    "./format-ago.js": "./format-ago.js",
    "./html/*": "./html/*"
  },
  "files": [
    "design.css",
    "elements",
    "format-ago.js",
    "html",
    "mark.svg"
  ],
  "dependencies": {
    "palace-ui": "^0.12.0"
  },
  "scripts": {
    "test": "node --test 'test/*.test.js'",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSES/MPL-2.0.txt', 'LICENSE')\""
  }
}

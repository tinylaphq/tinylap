{
  "name": "@tinylap/auth",
  "version": "0.3.0",
  "description": "Access token verification and permission checks for the TinyLap suite.",
  "license": "MPL-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinylaphq/tinylap.git",
    "directory": "packages/auth"
  },
  "exports": {

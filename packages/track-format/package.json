{
  "name": "@tinylap/track-format",
  "version": "0.3.0",
  "description": "Read, validate and draw Kyosho Mini-Z Grand Prix Circuit 30 track layouts.",
  "license": "MPL-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinylaphq/tinylap.git",
    "directory": "packages/track-format"
  },
  "exports": {
    ".": {
      "source": "./index.js",
      "types": "./dist/index.d.ts",
      "default": "./index.js"
    },
    "./types": {
      "types": "./types.d.ts"
    },
    "./layout.schema.json": "./layout.schema.json"
  },
  "files": [
    "*.js",
    "layout.schema.json",
    "types.d.ts",
    "dist"
  ],
  "scripts": {
    "test": "node --test 'test/**/*.test.js'",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "prepack": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('types.d.ts', 'dist/types.d.ts')\" && node -e \"require('node:fs').copyFileSync('../../LICENSES/MPL-2.0.txt', 'LICENSE')\""
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}

{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.js",
    "commitlint.config.js"
  ],
  "tasks": {
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "test": {
      "dependsOn": [
        "transit"
      ]
    },
    "lint": {
      "dependsOn": [
        "transit"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "transit"
      ]
    }
  }
}
